root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.RS2008.severity = warning

[tests/**/*.cs]
# Test-only analyzer placeholders are hosted by a .NET test runner with Workspaces.
dotnet_diagnostic.RS1036.severity = none
dotnet_diagnostic.RS1038.severity = none
dotnet_diagnostic.RS1041.severity = none
